# Pythonが自動生成するキャッシュ
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.hypothesis/

# カバレッジ・プロファイル出力
.coverage
.coverage.*
coverage.xml
htmlcov/
*.prof

# Pythonパッケージの構築物
build/
dist/
*.egg-info/
*.egg

# OS固有のファイル
.DS_Store
Thumbs.db

# 過去のバージョンや別バージョンのフォルダ
# (これらはGitのコミット履歴やブランチで管理すべきものです)
past/
fer_ver/
# 仮想環境（退避名やPythonバージョン付きも含む）
.venv*/
venv/
env/
ENV/

# ローカル実行時の一時データ
/.deepface/
*.tmp
*.temp

# Private theme repositories and personal assets must never enter this public repo.
.private/
